@ Multi-region dialogue for Professor Oak
PalletTown_ProfessorOaksLab_Text_OakWelcomeHoennTrainer::
    .string "OAK: Ah, {PLAYER}!\p"
    .string "Welcome to the Kanto region!\p"
    .string "I've heard about your adventures\n"
    .string "in the Hoenn region.\p"
    .string "It's wonderful to see a trainer\n"
    .string "who has already proven themselves!$"

PalletTown_ProfessorOaksLab_Text_OakMultiRegionJurisdiction::
    .string "OAK: However, there's something\n"
    .string "important you should know.\p"
    .string "Due to jurisdiction tussles between\n"
    .string "regions, the right to use HMs has to\l"
    .string "be obtained freshly in every region.\p"
    .string "This means you'll need to earn\n"
    .string "new HM permissions here in Kanto.$"

PalletTown_ProfessorOaksLab_Text_OakChooseKantoStarter::
    .string "OAK: Since you already have a POKéDEX,\n"
    .string "I won't give you another one.\p"
    .string "But I would like to offer you a\n"
    .string "Kanto starter POKéMON to help you\l"
    .string "on your journey through this region.\p"
    .string "Please choose one of these three\n"
    .string "POKéMON: CHARMANDER, BULBASAUR, or\l"
    .string "SQUIRTLE.$"
